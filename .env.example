# --- Phase 1: database & admin auth ---
# Railway Postgres public connection string
DATABASE_URL=postgresql://user:password@host.rlwy.net:12345/railway
# openssl rand -base64 32
SESSION_SECRET=
# bcrypt hash of the admin password (see scripts/hash-password.ts in Phase 1)
ADMIN_PASSWORD_HASH=

# --- Phase 2: image pipeline (runs locally, not needed on Vercel) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=spidey-shelf-images
# public base URL of the bucket (custom domain), used by next/image
NEXT_PUBLIC_IMAGE_BASE_URL=

# --- Phase 8 (optional): eBay Browse API ---
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
