# --- Phase 1: database & admin auth ---
# Railway Postgres connection string.
# Use the PUBLIC url (host ends in .rlwy.net / .proxy.rlwy.net) — postgres.railway.internal
# only resolves inside Railway's private network, so neither your laptop nor Vercel can
# reach it. Railway shows it as DATABASE_PUBLIC_URL in the service's Variables tab.
DATABASE_URL=postgresql://user:password@host.proxy.rlwy.net:12345/railway
# openssl rand -base64 32
SESSION_SECRET=
# bcrypt hash of the admin password: node scripts/hash-password.mjs 'your password'
# IMPORTANT: escape every `$` as `\$` here. Next.js parses .env with dotenv-expand, which
# reads `$2b$12$…` as variable references and silently eats most of the hash — quoting does
# NOT help. Paste the hash unescaped into the Vercel dashboard; only .env files need this.
# Example shape: ADMIN_PASSWORD_HASH=\$2b\$12\$abcdefghijklmnopqrstuv…
ADMIN_PASSWORD_HASH=

# --- Phase 9: box art uploaded by the owner (UploadThing) ---
# The ONLY variable the v7 SDK reads. uploadthing.com -> your app -> API Keys -> the
# "V7 token". It is a base64 blob carrying the API key, the app id and the region, so it
# replaces the v6 pair on its own. Alphanumeric + `=` padding — no `$`-escaping needed.
# Required on Vercel (Production + Preview): without it the upload route answers 500 and
# `onUploadComplete` cannot write `image_path`. Everything else on the site still works.
UPLOADTHING_TOKEN=
# NOT USED. The v6 `sk_live_…` secret; uploadthing v7 ignores it entirely (verified — with
# only this set, `new UTApi()` fails with "Missing token"). Safe to delete.
UPLOADTHING_SECRET=

# --- Phase 2: the pops.today image pipeline, still unbuilt (see ADR-004 / ADR-011) ---
# Only needed if image rights are ever cleared and box art is fetched in bulk instead of
# uploaded by hand. Nothing reads these today.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=spidey-shelf-images
# public base URL of the bucket (custom domain), used by next/image
NEXT_PUBLIC_IMAGE_BASE_URL=

# --- Phase 8 (optional): eBay Browse API — live prices on the figure pages ---
# Leave both blank and the feature does not exist: no MARKET SIGNAL panel, no wishlist price
# chips, and no request is ever made. Both or neither — a half-filled pair counts as blank.
# developer.ebay.com -> Application Keys -> PRODUCTION keyset (not Sandbox):
#   App ID (Client ID)   -> EBAY_CLIENT_ID
#   Cert ID (Client Secret) -> EBAY_CLIENT_SECRET
# See docs/wiki/Environment.md. No `$`-escaping needed — eBay keys are alphanumeric.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# --- Phase 11: the nightly price sweep ---
# Bearer token for GET /api/cron/refresh-prices, the job declared in vercel.json.
# Vercel sends `Authorization: Bearer <this>` on every scheduled invocation ALL BY ITSELF,
# as long as the variable exists on the project — so setting it here and on Vercel is the
# whole configuration. Generate with: openssl rand -base64 32
# A missing or blank value authorizes NOBODY (the endpoint answers 401 to everyone), which is
# the safe direction: the alternative turns a forgotten variable into a public endpoint that
# spends the day's eBay allowance for whoever finds the URL.
CRON_SECRET=
